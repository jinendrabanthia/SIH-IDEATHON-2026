// ─── Prisma Schema ─────────────────────────────────────────────────────────
// Multilingual Trustworthy Travel Assistant — Full Domain Model
// PostgreSQL + PostGIS via Supabase

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum VerificationStatus {
  VERIFIED
  LIVE
  COMMUNITY
  INFERRED
  UNVERIFIED
  OUTDATED
  DISPUTED
}

enum SourceType {
  GOVERNMENT
  OFFICIAL_TOURISM
  OFFICIAL_OPERATOR
  TRANSPORT_AUTHORITY
  WEATHER_SERVICE
  VERIFIED_LOCAL_ORG
  TRUSTED_THIRD_PARTY
  COMMUNITY
  AI_INFERENCE
}

enum CrowdLevel {
  LOW
  MODERATE
  HIGH
  SEVERE
}

enum SensitivityType {
  ENVIRONMENTAL
  CULTURAL
  COMMUNITY_RESTRICTION
}

enum FeedbackStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

enum TripStatus {
  DRAFT
  PLANNED
  ACTIVE
  COMPLETED
}

enum BudgetBand {
  BUDGET
  MODERATE
  PREMIUM
}

enum Pace {
  RELAXED
  MODERATE
  PACKED
}

enum GroupType {
  SOLO
  COUPLE
  FAMILY
  GROUP
}

enum TransportPreference {
  WALKING
  PUBLIC_TRANSIT
  CAB
  OWN_VEHICLE
  MIXED
}

// ─── User & Preferences ────────────────────────────────────────────────────

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String?  @map("password_hash")
  name              String?
  preferredLanguage String   @default("en") @map("preferred_language")
  supabaseId        String?  @unique @map("supabase_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  preferences UserPreference?
  trips       Trip[]
  feedback    Feedback[]

  @@map("users")
}

model UserPreference {
  id                      String              @id @default(uuid())
  userId                  String              @unique @map("user_id")
  budgetBand              BudgetBand?         @map("budget_band")
  pace                    Pace                @default(MODERATE)
  groupType               GroupType           @default(SOLO) @map("group_type")
  interests               String[]            @default([])
  foodPreferences         String[]            @default([]) @map("food_preferences")
  transportPreference     TransportPreference @default(MIXED) @map("transport_preference")
  accessibilityMobility   Boolean             @default(false) @map("accessibility_mobility")
  accessibilityVision     Boolean             @default(false) @map("accessibility_vision")
  accessibilityHearing    Boolean             @default(false) @map("accessibility_hearing")
  accessibilityCognitive  Boolean             @default(false) @map("accessibility_cognitive")
  accessibilityNotes      String?             @map("accessibility_notes")
  walkingToleranceMinutes Int                 @default(30) @map("walking_tolerance_minutes")
  indoorOutdoorPreference String              @default("mixed") @map("indoor_outdoor_preference")
  localBusinessPreference Boolean             @default(false) @map("local_business_preference")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ─── Destinations & Attractions ─────────────────────────────────────────────

model Destination {
  id        String   @id @default(uuid())
  name      String
  country   String   @default("India")
  region    String?
  latitude  Float
  longitude Float
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now()) @map("created_at")

  attractions     Attraction[]
  localBusinesses LocalBusiness[]
  trips           Trip[]

  @@map("destinations")
}

model Attraction {
  id                      String   @id @default(uuid())
  destinationId           String   @map("destination_id")
  name                    String
  categories              String[] @default([])
  latitude                Float
  longitude               Float
  address                 String?
  description             String?
  indoorOutdoor           String   @default("mixed") @map("indoor_outdoor")
  accessibilityWheelchair Boolean  @default(false) @map("accessibility_wheelchair")
  accessibilityVisual     Boolean  @default(false) @map("accessibility_visual")
  accessibilityHearing    Boolean  @default(false) @map("accessibility_hearing")
  accessibilityNotes      String?  @map("accessibility_notes")
  createdAt               DateTime @default(now()) @map("created_at")

  destination      Destination           @relation(fields: [destinationId], references: [id])
  facts            Fact[]
  crowdRecords     CrowdCapacityRecord[]
  sensitivityFlags SensitivityFlag[]
  itineraryItems   ItineraryItem[]

  @@map("attractions")
}

// ─── Facts & Sources (Core Provenance) ──────────────────────────────────────

model Source {
  id              String     @id @default(uuid())
  name            String
  sourceType      SourceType @map("source_type")
  url             String?
  reliabilityTier Int        @default(5) @map("reliability_tier")
  createdAt       DateTime   @default(now()) @map("created_at")

  facts               Fact[]
  verificationRecords VerificationRecord[]
  crowdRecords        CrowdCapacityRecord[]
  sensitivityFlags    SensitivityFlag[]
  localBusinesses     LocalBusiness[]       @relation("OwnershipEvidence")

  @@map("sources")
}

model Fact {
  id                 String             @id @default(uuid())
  entityType         String             @map("entity_type")
  entityId           String             @map("entity_id")
  factKey            String             @map("fact_key")
  factValue          Json               @map("fact_value")
  sourceId           String             @map("source_id")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  confidence         Float              @default(0.5)
  geographicScope    String?            @map("geographic_scope")
  timestamp          DateTime           @default(now())
  lastChecked        DateTime           @default(now()) @map("last_checked")
  expiresAt          DateTime?          @map("expires_at")

  source              Source               @relation(fields: [sourceId], references: [id])
  attraction          Attraction?          @relation(fields: [entityId], references: [id])
  verificationRecords VerificationRecord[]
  feedback            Feedback[]

  @@index([entityType, entityId])
  @@index([factKey])
  @@index([verificationStatus])
  @@map("facts")
}

model VerificationRecord {
  id        String   @id @default(uuid())
  factId    String   @map("fact_id")
  checkedBy String   @map("checked_by")
  checkedAt DateTime @default(now()) @map("checked_at")
  result    String
  notes     String?
  sourceId  String?  @map("source_id")

  fact   Fact    @relation(fields: [factId], references: [id], onDelete: Cascade)
  source Source? @relation(fields: [sourceId], references: [id])

  @@map("verification_records")
}

// ─── Crowding & Sensitivity ─────────────────────────────────────────────────

model CrowdCapacityRecord {
  id                 String             @id @default(uuid())
  attractionId       String             @map("attraction_id")
  currentCrowdLevel  CrowdLevel         @default(LOW) @map("current_crowd_level")
  capacityValue      Int?               @map("capacity_value")
  sourceId           String?            @map("source_id")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  timestamp          DateTime           @default(now())

  attraction Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  source     Source?    @relation(fields: [sourceId], references: [id])

  @@map("crowd_capacity_records")
}

model SensitivityFlag {
  id              String          @id @default(uuid())
  attractionId    String          @map("attraction_id")
  sensitivityType SensitivityType @map("sensitivity_type")
  description     String?
  sourceId        String?         @map("source_id")
  activeFrom      DateTime?       @map("active_from")
  activeTo        DateTime?       @map("active_to")

  attraction Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  source     Source?    @relation(fields: [sourceId], references: [id])

  @@map("sensitivity_flags")
}

// ─── Local Business ─────────────────────────────────────────────────────────

model LocalBusiness {
  id                        String   @id @default(uuid())
  name                      String
  category                  String?
  latitude                  Float
  longitude                 Float
  destinationId             String   @map("destination_id")
  isLocallyOwned            Boolean? @map("is_locally_owned")
  ownershipEvidenceSourceId String?  @map("ownership_evidence_source_id")
  description               String?

  destination     Destination @relation(fields: [destinationId], references: [id])
  ownershipSource Source?     @relation("OwnershipEvidence", fields: [ownershipEvidenceSourceId], references: [id])

  @@map("local_businesses")
}

// ─── Trips & Itineraries ────────────────────────────────────────────────────

model Trip {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  destinationId String     @map("destination_id")
  startDate     DateTime   @map("start_date")
  endDate       DateTime   @map("end_date")
  status        TripStatus @default(DRAFT)
  createdAt     DateTime   @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id])
  itineraries Itinerary[]

  @@map("trips")
}

model Itinerary {
  id             String   @id @default(uuid())
  tripId         String   @map("trip_id")
  generatedAt    DateTime @default(now()) @map("generated_at")
  plannerVersion String   @default("1.0.0") @map("planner_version")
  rawPlan        Json?    @map("raw_plan")
  validated      Boolean  @default(false)

  trip  Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items ItineraryItem[]

  @@map("itineraries")
}

model ItineraryItem {
  id                        String  @id @default(uuid())
  itineraryId               String  @map("itinerary_id")
  dayNumber                 Int     @map("day_number")
  sequence                  Int
  startTime                 String  @map("start_time")
  endTime                   String  @map("end_time")
  entityType                String  @default("attraction") @map("entity_type")
  entityId                  String  @map("entity_id")
  travelBufferMinutesBefore Int     @default(0) @map("travel_buffer_minutes_before")
  explanationText           String? @map("explanation_text")
  trustSummary              Json?   @map("trust_summary")

  itinerary  Itinerary   @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  attraction Attraction? @relation(fields: [entityId], references: [id])

  @@map("itinerary_items")
}

// ─── Feedback ───────────────────────────────────────────────────────────────

model Feedback {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  factId         String         @map("fact_id")
  submittedValue String?        @map("submitted_value")
  note           String?
  status         FeedbackStatus @default(PENDING)
  createdAt      DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fact Fact @relation(fields: [factId], references: [id])

  @@map("feedback")
}
