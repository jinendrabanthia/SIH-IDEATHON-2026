# ─────────────────────────────────────────────────────────────────────────────
# MargDarshak — Environment Variables Reference
# Copy to backend/.env and fill in real values. DO NOT commit filled .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase PostgreSQL + PostGIS) ─────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → Database → Connection String
DATABASE_URL=postgresql://postgres:<YOUR_DB_PASSWORD>@db.<YOUR_PROJECT_REF>.supabase.co:5432/postgres

# Supabase Project URL — from Dashboard → Project Settings → API
SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co

# Supabase Anon key — from Dashboard → Project Settings → API
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>

# ── LLM — Google Gemini ──────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# SERVER-SIDE ONLY. Never expose this in the frontend bundle.
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# ── Routing — OpenRouteService ───────────────────────────────────────────────
# Get from: https://openrouteservice.org/dev/#/signup (free tier: 2000 req/day)
# Planner falls back to 20-min estimate if this key is missing or invalid.
ROUTING_API_KEY=<YOUR_OPENROUTESERVICE_API_KEY>

# ── Weather — Open-Meteo ─────────────────────────────────────────────────────
# No key needed — Open-Meteo is free and keyless. See: https://open-meteo.com

# ── JWT Auth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
# Min 32 chars. App refuses to start in production with the dev placeholder.
JWT_SECRET=dev-jwt-secret-change-me-in-production-use-openssl-rand-hex-64

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7
# COOKIE_DOMAIN=.yourdomain.com   # Uncomment for production

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
